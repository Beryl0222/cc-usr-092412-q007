{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "超慢跑风险接力领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PLAN_APPROVED",
        "SESSION_RECORDED",
        "RISK_FLAGGED",
        "ACTIVITY_PAUSED",
        "REVIEW_COMPLETED",
        "SCREENING_RECORDED",
        "PRESCRIPTION_ISSUED",
        "PRESCRIPTION_TRANSFERRED",
        "SESSION_SCHEDULED",
        "SESSION_COMPLETED",
        "SESSION_REJECTED",
        "OBSERVATION_RECORDED",
        "RISK_SUGGESTION_GENERATED",
        "RISK_ESCALATED",
        "ACTIVITY_RESUMED",
        "EMERGENCY_STOPPED",
        "RETRO_REVIEW_OPENED",
        "RETRO_REVIEW_RESOLVED",
        "VENUE_HANDOFF_COMPLETED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "participant_plan",
        "activity_session",
        "risk_observation",
        "clinical_handoff",
        "participant_chain",
        "prescription",
        "training_session",
        "review_task",
        "venue_handoff"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
